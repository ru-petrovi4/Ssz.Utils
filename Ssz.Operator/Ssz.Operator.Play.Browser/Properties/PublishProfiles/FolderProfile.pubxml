<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <!-- Not bin\Release\net10.0-browser\browser-wasm\publish\, which is what the Visual
         Studio wizard writes here: the WebAssembly SDK rewrites exactly that value back
         to $(OutputPath)publish\ (workaround for dotnet/sdk#12114), so the folder named
         in the profile stays empty. Any other path is used as written. -->
    <PublishDir>bin\Release\net10.0-browser\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
</Project>