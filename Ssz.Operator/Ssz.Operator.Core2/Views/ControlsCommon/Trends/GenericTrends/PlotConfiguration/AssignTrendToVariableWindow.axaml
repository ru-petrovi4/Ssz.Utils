<Window x:Class="Ssz.Operator.Core.ControlsCommon.Trends.GenericTrends.PlotConfiguration.AssignTrendToVariableWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:plotConfiguration="using:Ssz.Operator.Core.ControlsCommon.Trends.GenericTrends.PlotConfiguration"
        Title="Определение Сссылки на Параметр" Height="285" Width="600" CanResize="False"
        mc:Ignorable="d"
        x:DataType="plotConfiguration:TrendConfigurationViewModel"
        Topmost="True" WindowStartupLocation="CenterOwner">
    <Design.DataContext>
        <plotConfiguration:TrendConfigurationDesignData />
    </Design.DataContext>
    <Grid>
        <Button Content="OK" Margin="0,10,68,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="75"
                Click="OnOkButtonClicked" />
        <Button Content="Отмена" Margin="0,37,68,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="75"
                Click="OnCancelButtonClicked" />
        <Button Content="Отбор" Margin="0,73,68,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="75"
                IsEnabled="False" />
        <TextBlock HorizontalAlignment="Left" Margin="19,60,0,0" TextWrapping="Wrap"
                   Text="Введите новую ссылку на Параметр:" VerticalAlignment="Top" />
        <TextBox HorizontalAlignment="Left" Height="122" Margin="10,81,0,0" TextWrapping="Wrap"
                 Text="{Binding HdaId, Mode=TwoWay}"
                 VerticalAlignment="Top" Width="418" />

    </Grid>
</Window>
