<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Ssz.Operator.Core.VisualEditors.DsUIElementPropertyEditorControl">
  <Grid Name="MainGrid" Margin="5" RowDefinitions="Auto,*,Auto">
    <ComboBox Grid.Row="0" Name="MainComboBox" HorizontalAlignment="Stretch" />
    <TextBox Grid.Row="1" Name="MainTextBox" Margin="0,5,0,0"
             TextWrapping="Wrap" AcceptsReturn="True" />
  </Grid>
</UserControl>
