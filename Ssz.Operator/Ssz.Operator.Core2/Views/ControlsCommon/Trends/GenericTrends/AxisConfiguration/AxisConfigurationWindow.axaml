<Window x:Class="Ssz.Operator.Core.ControlsCommon.Trends.GenericTrends.AxisConfiguration.AxisConfigurationWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:axisConfiguration="using:Ssz.Operator.Core.ControlsCommon.Trends.GenericTrends.AxisConfiguration"
        Height="179" Width="350"
        mc:Ignorable="d"
        x:DataType="axisConfiguration:AxisConfigurationViewModel"
        Title="{Binding Title}" Topmost="True" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Design.DataContext>
        <axisConfiguration:AxisConfigurationDesignData />
    </Design.DataContext>
    <Grid>
        <TextBlock HorizontalAlignment="Left" Margin="19,34,0,0" TextWrapping="Wrap" Text="Верхний Предел Y:"
                   VerticalAlignment="Top" />
        <TextBlock HorizontalAlignment="Left" Margin="19,62,0,0" TextWrapping="Wrap" Text="Нижний Предел Y:"
                   VerticalAlignment="Top" />
        <TextBox HorizontalAlignment="Left" Height="23" Margin="128,31,0,0" TextWrapping="Wrap"
                 Text="{Binding Maximum, Mode=TwoWay}"
                 VerticalAlignment="Top" Width="86"
                 HorizontalContentAlignment="Right" />
        <TextBox HorizontalAlignment="Left" Height="23" Margin="128,59,0,0" TextWrapping="Wrap"
                 Text="{Binding Minimum, Mode=TwoWay}"
                 VerticalAlignment="Top" Width="86"
                 HorizontalContentAlignment="Right" />
        <Button Content="OK" HorizontalAlignment="Left" Margin="259,15,0,0" VerticalAlignment="Top" Width="75"
                Click="OnOkButtonClicked" />
        <Button Content="Отмена" HorizontalAlignment="Left" Margin="259,43,0,0" VerticalAlignment="Top" Width="75"
                Click="OnCancelButtonClicked" />
        <TextBlock HorizontalAlignment="Left" Margin="34,87,0,0" TextWrapping="Wrap"
                   Text="Внимание. Изменения, выполненные здесь приведут к изменению сконфигурированных Вами пределов шкалы Y"
                   VerticalAlignment="Top"
                   Width="254" />

    </Grid>
</Window>
